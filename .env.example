# Kopiere diese Datei nach apps/web/.env.local und trage echte Werte ein.
# Echte Werte gehören NIEMALS ins Repository (siehe .gitignore).

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig (Vercel: als normale, NICHT-öffentliche Variable anlegen)
SUPABASE_SECRET_KEY=

# --- Website ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TWITCH_CHANNEL=xLennox_Tv
# Link zur Ticket-Seite auf eurem Discord (Verifizierung)
NEXT_PUBLIC_DISCORD_TICKET_URL=

# --- Discord (beides optional; du trägst es später selbst ein) ---
# Einladungslink zu eurem Community-Server: erscheint im Shop und bei den Creator-Codes
NEXT_PUBLIC_DISCORD_SERVER_URL=
# Webhook-URL eines Discord-Kanals für neue Shop-Bestellungen. GEHEIM, nur serverseitig (nicht NEXT_PUBLIC_).
DISCORD_SHOP_WEBHOOK_URL=

# --- Twitch Live-Status (optional; ohne diese Werte zeigt der Banner "Status unbekannt") ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Betreiberangaben für Impressum und Datenschutz (öffentlich sichtbar, bewusst nicht vorbelegt) ---
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
